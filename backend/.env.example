DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Kolkata

AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- OWNER / ADMIN SETUP (IMPORTANT) -----------------------------------------
# Paste any long random secret here. This is YOUR key to become the admin:
#   1. Put a secret code below (e.g. a long random string).
#   2. Open the website at /admin-setup, enter this code + your email + a
#      password (8+ chars). That account instantly becomes the admin.
#   3. The code lives only in this file on the server -- nobody else can see
#      it, and there is no admin button anywhere in the UI.
# After you become admin you can delete the code to lock the endpoint.
ADMIN_SETUP_CODE=paste-a-long-random-secret-code-here

# Optional: credentials used ONLY by `python seed.py` to create the admin.
# Leave empty to skip admin seeding (use /admin-setup instead).
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Production email (optional; console backend is used by default)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
